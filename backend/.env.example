# Rafid backend configuration (all values have dev defaults in app/config.py)

ENV=dev
DATABASE_URL=postgresql+asyncpg://rafid:rafid@localhost:5433/rafid

# Comma-separated exact CORS origins. *.vercel.app previews are always allowed via regex.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth
JWT_SECRET=change-me-in-prod
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Encryption at rest (Fernet key; generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Seams
PROVIDER=mock                # mock | lean
SCORING_BACKEND=module       # stub | module (rafid-engine) | http

# Monitoring agent (1 tick = 1 simulated day)
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=15

# Fee schedule — PLACEHOLDERS until Faisal confirms (§18)
PLATFORM_FEE_PCT=0.02
SUCCESS_FEE_PCT=0.01
MURABAHA_PROFIT_PCT=0.06
MAX_ADVANCE_RATIO=0.80
OFFER_EXPIRY_DAYS=7
