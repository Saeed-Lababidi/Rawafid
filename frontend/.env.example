# Base URL of the Rafid backend API (D-04).
# This is the ONLY source of the backend host — no host string is hardcoded
# anywhere in source. Copy this file to .env.local for local development.
#
# Local dev:  http://localhost:8000
# Production: the deployed Railway URL is wired into the Vercel project
#             environment in plan 01-04 (replace the placeholder below).
NEXT_PUBLIC_API_URL=https://YOUR-APP.up.railway.app
