# Base URL of the Rafid backend API (D-04).
# This is the ONLY source of the backend host — no host string is hardcoded
# anywhere in source. Copy this file to .env.local for local development.
#
# Local dev against a local backend:  http://localhost:8000
# Live deployed backend (Railway) — the default below; no local backend needed.
NEXT_PUBLIC_API_URL=https://rawafid-production.up.railway.app
